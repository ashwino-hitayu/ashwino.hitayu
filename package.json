{
  "name": "hitayu-dosha-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "visual:baseline": "node scripts/visual-check.mjs baseline",
    "visual:compare": "node scripts/visual-check.mjs compare",
    "images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" vite.config.js eslint.config.js",
